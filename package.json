{
	"name": "@alessiofrittoli/crypto-otp",
	"version": "3.1.0",
	"description": "Lightweight TypeScript HOTP/TOTP library",
	"type": "module",
	"author": {
		"name": "Alessio Frittoli",
		"email": "info@alessiofrittoli.it",
		"url": "https://alessiofrittoli.it"
	},
	"license": "MIT",
	"keywords": [
		"crypto",
		"security",
		"cyber-security",
		"authorization",
		"auth-cerimony",
		"otp",
		"otpauth",
		"one-time-password",
		"one-time-passwords",
		"hotp",
		"hmac-one-time-passwords",
		"time-based-one-time-passwords",
		"totp"
	],
	"homepage": "https://github.com/alessiofrittoli/crypto-otp#readme",
	"bugs": {
		"url": "https://github.com/alessiofrittoli/crypto-otp/issues",
		"email": "info@alessiofrittoli.it"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alessiofrittoli/crypto-otp.git"
	},
	"engines": {
		"node": ">=24.15.0",
		"pnpm": ">=11.27.1"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./*": {
			"import": {
				"types": "./dist/*/index.d.mts",
				"default": "./dist/*/index.mjs"
			},
			"require": {
				"types": "./dist/*/index.d.cts",
				"default": "./dist/*/index.cjs"
			}
		}
	},
	"sideEffects": false,
	"scripts": {
		"//1a": "*********************************************************************",
		"//1b": "******************** DEV - BUILD - LINT - RELEASE *******************",
		"//1c": "*********************************************************************",
		"dev": "tsdown --watch",
		"build": "pnpm lint && pnpm tsdown",
		"lint": "oxlint --report-unused-disable-directives --max-warnings 0",
		"release": "node scripts/release.ts --verbose --npm",
		"//2a": "*********************************************************************",
		"//2b": "***************************** UNIT TESTS ****************************",
		"//2c": "*********************************************************************",
		"test": "vitest --reporter=tree",
		"test:watch": "pnpm test watch",
		"test:ci": "pnpm test run",
		"//3a": "*********************************************************************",
		"//3b": "************************ UNIT TESTS COVERAGE ************************",
		"//3c": "*********************************************************************",
		"test:coverage": "pnpm test:watch --coverage",
		"test:coverage:ci": "pnpm test:ci --coverage",
		"test:serve-coverage": "http-server ./coverage --gzip true -p 0 -o /index.html --silent",
		"test:coverage:serve": "concurrently --prefix none --kill-others \"pnpm test:coverage\" \"pnpm test:serve-coverage\""
	},
	"peerDependencies": {
		"@alessiofrittoli/crypto-algorithm": "^2.5.0",
		"@alessiofrittoli/crypto-encoder": "^3.4.0",
		"@alessiofrittoli/crypto-key": "^4.0.1",
		"@alessiofrittoli/exception": "^4.2.0",
		"@alessiofrittoli/math-utils": "^2.2.0",
		"@alessiofrittoli/url-utils": "^4.2.0"
	},
	"devDependencies": {
		"@alessiofrittoli/crypto-algorithm": "^2.5.0",
		"@alessiofrittoli/crypto-encoder": "^3.4.0",
		"@alessiofrittoli/crypto-key": "^4.0.1",
		"@alessiofrittoli/exception": "^4.2.0",
		"@alessiofrittoli/math-utils": "^2.2.0",
		"@alessiofrittoli/node-scripts": "^4.2.0",
		"@alessiofrittoli/package-configs": "^1.9.0",
		"@alessiofrittoli/url-utils": "^4.2.0",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.0.5",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"prettier": "^3.9.10",
		"prettier-plugin-sort-imports": "^1.8.11",
		"tsdown": "^0.23.2",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
